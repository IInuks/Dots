{
    "surface": "#19120c",
    "foreground": "#efe0d5",
    "accent": "#feb876",
    "barOpacity": 0.88,
    "radius": 0,
    "hasLauncher": true,
    "keybinds": [
        "bind=SUPER,space,spawn,qs -p ~/quickdots/bars/ricev2 ipc call launcher toggle",
        "bind=SUPER,Escape,spawn,qs -p ~/quickdots/bars/ricev2 ipc call power toggle",
        "bind=ALT,Tab,spawn,qs -p ~/quickdots/bars/ricev2 ipc call switch open",
        "bind=ALT+SHIFT,Tab,spawn,qs -p ~/quickdots/bars/ricev2 ipc call switch prev",
        "bind=ALT,Return,spawn,qs -p ~/quickdots/bars/ricev2 ipc call switch confirm",
        "bind=ALT,Escape,spawn,qs -p ~/quickdots/bars/ricev2 ipc call switch cancel",
        "bind=ALT,c,spawn,qs -p ~/quickdots/bars/ricev2 ipc call switch close"
    ]
}
