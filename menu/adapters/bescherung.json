{
    "surface": "#fbf3e4",
    "foreground": "#2a2130",
    "accent": "#d9434f",
    "barOpacity": 1.0,
    "radius": 8,
    "hasLauncher": true,
    "keybinds": [
        "bind=SUPER,space,spawn,qs -p @QUICKDOTS_ROOT@/bars/bescherung ipc call bescherung launcher",
        "bind=SUPER,Escape,spawn,qs -p @QUICKDOTS_ROOT@/bars/bescherung ipc call bescherung power",
        "bind=CTRL+SUPER,g,spawn,qs -p @QUICKDOTS_ROOT@/bars/bescherung ipc call bescherung tagesgeschenk"
    ]
}
